# CI-only runtime image: the Go binary is built on the runner by setup-go from
# go.mod's go directive, the same toolchain test.yaml tests with, and copied
# in (build.yaml). For local from-source builds use the Dockerfile without the
# .release suffix.
# distroless/static ships CA certs (outbound TLS to Anthropic, S3 storage and Postgres).
FROM gcr.io/distroless/static-debian12:nonroot
COPY out/server /server
EXPOSE 8080
USER nonroot:nonroot
ENTRYPOINT ["/server"]
